---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Sidebar from '../../components/Sidebar.astro';
import StoryCard from '../../components/StoryCard.astro';
import { categories, categoryBlurb, categoryLabel } from '../../data/site';

export async function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const all = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const stories = all.filter((a) => a.data.category === slug);
const lead = stories[0];
const rest = stories.slice(1);
const popular = [...all].sort((a, b) => b.data.readMinutes - a.data.readMinutes).slice(0, 5);
const label = categoryLabel(slug!);
const blurb = categoryBlurb(slug!);
---

<BaseLayout title={label} description={blurb}>
  <div class="shell top-ad">
    <AdSlot size="leaderboard" slotId={`category-${slug}-leaderboard`} />
  </div>

  <div class="shell page-grid">
    <main id="main" class="main">
      <header class="cat-head">
        <p class="kicker">Section</p>
        <h1 class="display cat-title">{label}</h1>
        <p class="cat-blurb">{blurb}</p>
        <hr class="rule rule--double" />
      </header>

      {
        lead ? (
          <section class="cat-lead">
            <StoryCard article={lead} size="feature" showHero={true} />
          </section>
        ) : (
          <p class="empty">No stories in this section yet.</p>
        )
      }

      {
        rest.length > 0 && (
          <section class="band">
            <div class="band__head">
              <h2 class="section-title">More in {label}</h2>
              <span class="meta">{stories.length} stories</span>
            </div>
            <div class="cat-grid">
              {rest.map((article) => (
                <StoryCard article={article} size="md" showHero={true} showDek={true} />
              ))}
            </div>
          </section>
        )
      }
    </main>

    <Sidebar latest={all} popular={popular} />
  </div>
</BaseLayout>

<style>
  .top-ad {
    padding-top: 1.15rem;
  }

  .cat-head {
    margin-bottom: 1.5rem;
  }

  .cat-title {
    font-size: clamp(2.5rem, 5vw, 3.6rem);
    margin: 0.2rem 0 0.55rem;
  }

  .cat-blurb {
    margin: 0 0 1rem;
    color: var(--ink-soft);
    max-width: 52ch;
    font-size: 1.08rem;
  }

  .cat-lead {
    margin-bottom: 2rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem 1.5rem;
  }

  .empty {
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .cat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
