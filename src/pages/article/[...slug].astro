---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Sidebar from '../../components/Sidebar.astro';
import StoryCard from '../../components/StoryCard.astro';
import { site, categoryLabel, formatDate } from '../../data/site';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;

const all = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const related = all
  .filter((a) => a.data.category === article.data.category && a.id !== article.id)
  .slice(0, 3);

const popular = [...all].sort((a, b) => b.data.readMinutes - a.data.readMinutes).slice(0, 5);

const imageSrc = article.data.image ? withBase(article.data.image.replace(/^\//, '')) : null;

function escapeHtml(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

/** Turn markdown body blocks into HTML (paragraphs + blockquotes). */
function blockToHtml(block: string): string {
  const trimmed = block.trim();
  if (!trimmed) return '';

  if (trimmed.startsWith('>')) {
    const quote = trimmed
      .split('\n')
      .map((line) => line.replace(/^>\s?/, ''))
      .join(' ')
      .trim();
    return `<blockquote><p>${escapeHtml(quote)}</p></blockquote>`;
  }

  const para = trimmed.replace(/\n+/g, ' ').trim();
  return `<p>${escapeHtml(para)}</p>`;
}

const blocks = (article.body ?? '')
  .trim()
  .split(/\n\s*\n/)
  .map((b) => b.trim())
  .filter(Boolean);

// Place a single in-article ad near the middle (never at the end alone)
const mid = Math.max(2, Math.min(blocks.length - 2, Math.floor(blocks.length / 2)));
const beforeHtml = blocks.slice(0, mid).map(blockToHtml).join('\n');
const afterHtml = blocks.slice(mid).map(blockToHtml).join('\n');
---

<BaseLayout title={article.data.title} description={article.data.dek}>
  <div class="shell top-ad">
    <AdSlot size="leaderboard" slotId="article-leaderboard-1" />
  </div>

  <div class="shell page-grid">
    <main id="main" class="main">
      <article class="article">
        <header class="article-header">
          <p class="kicker">
            <a href={withBase(`category/${article.data.category}`)}>
              {categoryLabel(article.data.category)}
            </a>
          </p>
          <h1 class="display article-title">{article.data.title}</h1>
          <p class="article-dek">{article.data.dek}</p>
          <div class="byline">
            <div>
              <p class="byline__author">By {article.data.author}</p>
              <p class="meta">
                {formatDate(article.data.pubDate)} · {article.data.readMinutes} min read
              </p>
            </div>
            {
              article.data.tags.length > 0 && (
                <div class="tags">
                  {article.data.tags.map((tag) => (
                    <span class="chip">{tag}</span>
                  ))}
                </div>
              )
            }
          </div>
        </header>

        {
          imageSrc ? (
            <figure class="article-hero">
              <img
                src={imageSrc}
                alt=""
                width="960"
                height="540"
                loading="eager"
                decoding="async"
              />
            </figure>
          ) : (
            <div
              class="hero-panel hero-panel--article"
              style={`--tone: ${article.data.heroTone}`}
              role="img"
              aria-label="Story illustration"
            />
          )
        }

        {/* First half of story */}
        <div class="prose" set:html={beforeHtml} />

        {/* Single mid-article unit only */}
        <div class="in-article-ad">
          <AdSlot size="inarticle" slotId="article-incontent-1" />
        </div>

        {/* Second half of story */}
        <div class="prose prose-after" set:html={afterHtml} />

        <p class="endnote">
          Reporting for this story was prepared for The Harbor Ledger’s{' '}
          {categoryLabel(article.data.category).toLowerCase()} desk. Tips:
          {site.email}
        </p>
      </article>

      {
        related.length > 0 && (
          <section class="band">
            <div class="band__head">
              <h2 class="section-title">More in {categoryLabel(article.data.category)}</h2>
              <a href={withBase(`category/${article.data.category}`)}>
                View section
              </a>
            </div>
            <div class="grid-3">
              {related.map((item) => (
                <StoryCard article={item} size="sm" showDek={true} />
              ))}
            </div>
          </section>
        )
      }
    </main>

    <Sidebar latest={all} popular={popular} />
  </div>
</BaseLayout>

<style>
  .top-ad {
    padding-top: 0.85rem;
  }

  .article-header {
    margin-bottom: 0.85rem;
  }

  .article-header .kicker a {
    text-decoration: none;
  }

  .article-title {
    font-size: clamp(2.15rem, 4.2vw, 3.05rem);
    margin: 0.25rem 0 0.65rem;
    max-width: none;
    line-height: 1.12;
  }

  .article-dek {
    font-size: 1.22rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0 0 1rem;
    max-width: none;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.75rem 0 0.9rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .byline__author {
    margin: 0 0 0.1rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.92rem;
  }

  .byline .meta {
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }

  .article-hero {
    margin: 0 0 1.35rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    overflow: hidden;
  }

  .article-hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    max-height: 400px;
    object-fit: cover;
    display: block;
  }

  .article .prose {
    max-width: none;
  }

  /* No drop cap on the second half after the ad */
  .prose-after :global(p:first-of-type::first-letter) {
    font-size: inherit;
    font-family: inherit;
    font-weight: inherit;
    float: none;
    line-height: inherit;
    padding: 0;
    margin: 0;
  }

  .in-article-ad {
    margin: 1.75rem 0 1.85rem;
    padding: 0.35rem 0;
  }

  .endnote {
    font-size: 0.95rem;
    color: var(--muted);
    border-top: 1px solid var(--rule);
    padding-top: 1.1rem;
    margin: 1.5rem 0 0;
    font-style: italic;
    line-height: 1.5;
  }

  .band {
    margin-top: 2.25rem;
  }

  :global(.ad-slot--inarticle) {
    margin: 0 auto;
  }
</style>
