---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import { site, categories } from '../data/site';
import { withBase } from '../lib/paths';

const latest = (await getCollection('articles'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout title="Page not found" description={`That page does not exist on ${site.name}.`}>
  <div class="shell notfound">
    <main id="main">
      <p class="kicker">Error 404</p>
      <h1 class="display nf-title">That page has gone to press without us</h1>
      <p class="nf-lede">
        The address you followed does not match anything in our archive. It may have moved, or the
        link may have been mistyped.
      </p>

      <p class="nf-links">
        <a href={withBase()}>Front page</a> · <a href={withBase('authors')}>Contributors</a> ·
        <a href={withBase('about')}>About</a> · <a href={withBase('contact')}>Contact</a>
      </p>

      <p class="nf-label">Sections</p>
      <ul class="nf-sections">
        {
          categories.map((c) => (
            <li>
              <a href={withBase(`category/${c.slug}`)}>{c.label}</a>
            </li>
          ))
        }
      </ul>

      <p class="nf-label">Latest reporting</p>
      <div class="nf-grid">
        {latest.map((a) => <StoryCard article={a} size="standard" showHero={true} />)}
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding: 2.5rem 0 3rem;
  }

  .nf-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin: 0.25rem 0 0.75rem;
    max-width: 24ch;
  }

  .nf-lede {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 46ch;
    margin: 0 0 1.25rem;
    line-height: 1.55;
  }

  .nf-links {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    margin: 0 0 2.25rem;
  }

  .nf-label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule);
  }

  .nf-sections {
    list-style: none;
    padding: 0;
    margin: 0 0 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  .nf-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .nf-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .nf-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
