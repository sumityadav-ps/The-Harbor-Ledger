---
import { site, categories } from '../data/site';
import { withBase } from '../lib/paths';
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div>
        <p class="footer-brand">{site.name}</p>
        <p class="footer-blurb">{site.description}</p>
      </div>
      <div>
        <p class="footer-label">Sections</p>
        <ul class="footer-links">
          {
            categories.map((c) => (
              <li>
                <a href={withBase(`category/${c.slug}`)}>{c.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="footer-label">Newsroom</p>
        <ul class="footer-links">
          <li><a href={withBase('about')}>About</a></li>
          <li><a href={withBase('authors')}>Contributors</a></li>
          <li><a href={withBase('contact')}>Contact</a></li>
          <li><a href={withBase('editorial-policy')}>Editorial Policy</a></li>
          <li><a href={withBase('advertise')}>Advertising</a></li>
          <li><a href={withBase('privacy')}>Privacy Policy</a></li>
          <li><a href={withBase('terms')}>Terms of Use</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
      <p class="footer-note">
        <a href={withBase('privacy')}>Privacy</a> · <a href={withBase('terms')}>Terms</a> ·
        <a href={withBase('editorial-policy')}>Editorial Policy</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 2rem;
    padding: 2.5rem 0 2rem;
    border-top: 3px double var(--rule-strong);
    background: linear-gradient(180deg, transparent, rgba(28, 43, 58, 0.04));
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    margin: 0 0 0.65rem;
    letter-spacing: -0.02em;
  }

  .footer-blurb {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 34ch;
  }

  .footer-label {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
    color: var(--muted);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .footer-links a,
  .footer-links span {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-top: 1rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 800px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
