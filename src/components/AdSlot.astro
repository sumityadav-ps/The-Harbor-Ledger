    gap: 18px;
  }

  .om-ad--billboard .om-ad__media {
    width: 160px;
    height: 160px;
  }

  .om-ad--billboard .om-ad__logo {
    font-size: 3rem;
  }

  .om-ad--billboard .om-ad__headline {
    font-size: 26px;
  }

  .om-ad--billboard .om-ad__line2 {
    font-size: 15px;
  }

  .om-ad--billboard .om-ad__cta {
    padding: 12px 18px;
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .om-ad--lb .om-ad__line2 {
      display: none;
    }
    .om-ad--lb .om-ad__domain {
      display: none;
    }
    .om-ad--lb .om-ad__headline {
      font-size: 13px;
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
