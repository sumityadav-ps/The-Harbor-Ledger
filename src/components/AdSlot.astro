    gap: 0;
    padding: 0;
    height: 100%;
  }

  .om-ad--mpu .om-ad__media {
    width: 100%;
    height: 120px;
    border-radius: 0;
  }

  .om-ad--mpu .om-ad__logo {
    font-size: 2.4rem;
  }

  .om-ad--mpu .om-ad__body {
    padding: 10px 12px 6px;
  }

  .om-ad--mpu .om-ad__headline {
    font-size: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    white-space: normal;
  }

  .om-ad--mpu .om-ad__line2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .om-ad--mpu .om-ad__cta-wrap {
    padding: 0 12px 12px;
    justify-content: stretch;
  }

  .om-ad--mpu .om-ad__cta {
    width: 100%;
    padding: 10px 12px;
  }

  /* Half page 300x600 */
  .om-ad--halfpage {
    max-width: 300px;
    height: 600px;
    margin-inline: auto;
  }

  .om-ad--halfpage .om-ad__frame {
    grid-template-columns: 1fr;
    grid-template-rows: 1.2fr auto auto;
    gap: 0;
    padding: 0;
    height: 100%;
  }

  .om-ad--halfpage .om-ad__media {
    width: 100%;
    min-height: 300px;
    height: 100%;
    border-radius: 0;
  }

  .om-ad--halfpage .om-ad__logo {
    font-size: 4.5rem;
  }

  .om-ad--halfpage .om-ad__price {
    font-size: 14px;
    left: 12px;
    bottom: 12px;
    padding: 4px 10px;
  }

  .om-ad--halfpage .om-ad__body {
    padding: 16px 14px 8px;
  }

  .om-ad--halfpage .om-ad__brand {
    font-size: 13px;
  }

  .om-ad--halfpage .om-ad__headline {
    font-size: 22px;
    line-height: 1.18;
    margin-top: 4px;
  }

  .om-ad--halfpage .om-ad__line2 {
    font-size: 14px;
    margin-top: 8px;
  }

  .om-ad--halfpage .om-ad__cta-wrap {
    padding: 8px 14px 16px;
    justify-content: stretch;
  }

  .om-ad--halfpage .om-ad__cta {
    width: 100%;
    padding: 12px;
    font-size: 14px;
  }

  /* Billboard */
  .om-ad--billboard {
    max-width: 970px;
    height: 250px;
    margin-inline: auto;
  }

  .om-ad--billboard .om-ad__frame {
    grid-template-columns: 160px 1fr auto;
