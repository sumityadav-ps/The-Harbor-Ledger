/**
 * Mock open-market display creatives for publisher inventory testing.
 * Each creative is a distinct brand treatment (not one shared template skin).
 */
interface Props {
  size: 'leaderboard' | 'mpu' | 'halfpage' | 'billboard' | 'inarticle';
  slotId: string;
}

const { size, slotId } = Astro.props;

