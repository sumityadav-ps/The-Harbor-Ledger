    text-overflow: ellipsis;
  }

  .om-ad--lb .om-ad__line2 {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* MPU 300x250 */
  .om-ad--mpu {
    max-width: 300px;
    height: 250px;
    margin-inline: auto;
  }

  .om-ad--mpu .om-ad__frame {
    grid-template-columns: 1fr;
