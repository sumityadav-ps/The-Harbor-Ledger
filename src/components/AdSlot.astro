---
/**
 * Placeholder ad inventory. Renders a labelled dotted frame at the requested
 * IAB size. Size shells live in global.css (.ad-slot--*).
 */
interface Props {
  size: 'leaderboard' | 'mpu' | 'halfpage' | 'billboard' | 'inarticle';
  slotId: string;
}

const { size, slotId } = Astro.props;

const sizeLabel =
  size === 'leaderboard' || size === 'inarticle'
    ? '728 × 90'
    : size === 'mpu'
      ? '300 × 250'
      : size === 'halfpage'
        ? '300 × 600'
        : '970 × 250';
---

<aside
  class:list={['ad-ph', `ad-slot--${size}`]}
  data-ad-slot={slotId}
  data-ad-size={sizeLabel.replace(/\s|×/g, (c) => (c === '×' ? 'x' : ''))}
  aria-label="Advertisement"
>
  <span class="ad-ph__label">Advertisement</span>
  <span class="ad-ph__size">{sizeLabel}</span>
</aside>

<style>
  .ad-ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border: 2px dotted var(--rule);
    background: var(--paper-deep);
    color: var(--muted);
    text-align: center;
    padding: 0.5rem;
    box-sizing: border-box;
  }

  .ad-ph__label {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1;
  }

  .ad-ph__size {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    line-height: 1;
    opacity: 0.75;
  }

  /* Leaderboard and in-article are short - keep the two labels on one line */
  .ad-slot--leaderboard,
  .ad-slot--inarticle {
    flex-direction: row;
    gap: 0.75rem;
  }

  /* Hold the declared size even when the sidebar rail goes full-width
     below 1100px, so the printed dimensions stay truthful. */
  .ad-ph.ad-slot--mpu,
  .ad-ph.ad-slot--halfpage {
    max-width: 300px;
    margin-inline: auto;
  }
</style>
