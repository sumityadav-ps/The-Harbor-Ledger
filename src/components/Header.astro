---
import { site, categories } from '../data/site';

const today = new Date().toLocaleDateString('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell">
    <div class="header-top">
      <p class="header-top__date">{today}</p>
      <p class="header-top__place">{site.location} Edition · Est. {site.founded}</p>
      <a class="header-top__link" href={`${import.meta.env.BASE_URL}about`}>About the Ledger</a>
    </div>

    <div class="masthead">
      <a class="masthead__brand" href={import.meta.env.BASE_URL}>
        <span class="masthead__mark" aria-hidden="true"></span>
        <span class="masthead__name">{site.name}</span>
      </a>
      <p class="masthead__tagline">{site.tagline}</p>
    </div>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        <li>
          <a href={import.meta.env.BASE_URL} class:list={[{ 'is-active': path === '/' || path === import.meta.env.BASE_URL }]}>
            Home
          </a>
        </li>
        {
          categories.map((cat) => {
            const href = `${import.meta.env.BASE_URL}category/${cat.slug}`;
            const active = path.includes(`/category/${cat.slug}`);
            return (
              <li>
                <a href={href} class:list={[{ 'is-active': active }]}>
                  {cat.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding-top: 0.85rem;
    border-bottom: 1px solid var(--rule);
    background: linear-gradient(180deg, #f9f5ec 0%, transparent 100%);
  }

  .header-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--muted);
    letter-spacing: 0.02em;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--rule);
  }

  .header-top__link {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .header-top__link:hover {
    color: var(--accent);
  }

  .masthead {
    text-align: center;
    padding: 1.35rem 0 1rem;
  }

  .masthead__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
  }

  .masthead__mark {
    width: 0.85rem;
    height: 0.85rem;
    background: var(--accent);
    box-shadow: 3px 3px 0 var(--navy);
  }

  .masthead__name {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.95;
    font-variation-settings: 'wght' 600;
  }

  .masthead__tagline {
    margin: 0.55rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .primary-nav {
    border-top: 3px double var(--rule-strong);
    border-bottom: 2px solid var(--rule-strong);
  }

  .primary-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15rem 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0.35rem 0;
  }

  .primary-nav a {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.45rem 0.7rem;
    color: var(--ink);
  }

  .primary-nav a:hover,
  .primary-nav a.is-active {
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .header-top__place {
      display: none;
    }

    .masthead {
      padding: 1rem 0 0.75rem;
    }
  }
</style>
